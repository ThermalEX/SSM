<Window x:Class="SSM.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSM Overlay"
        WindowStyle="None"
        Background="#1C1C1E"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

        <!-- 可旋转内容区 -->
        <Grid x:Name="RotatableContent" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部 branding -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,16">
                <Ellipse Width="7" Height="7" Fill="#0A84FF"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="SSM  Secondary Screen Monitor"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#4A4A4F" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2×2 数据卡片 -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="2">

                <!-- CPU -->
                <Border Background="#2C2C2E" CornerRadius="14"
                        Margin="0,0,6,6" Padding="22,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CPU"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,0,0,0"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <ProgressBar x:Name="OverlayCpuBar"
                                         Height="2" Maximum="100" Value="0"
                                         Background="#3A3A3C" Foreground="#0A84FF"
                                         BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="OverlayCpuLoadText" Text="负载 --%"
                                       FontSize="12" Foreground="#6E6E73"/>
                        </StackPanel>
                        <TextBlock x:Name="OverlayCpuTempText" Text="-- °C"
                                   FontSize="42" FontWeight="Light" Foreground="#F2F2F7"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- GPU -->
                <Border Background="#2C2C2E" CornerRadius="14"
                        Margin="6,0,0,6" Padding="22,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="GPU"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,0,0,0"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <ProgressBar x:Name="OverlayGpuBar"
                                         Height="2" Maximum="100" Value="0"
                                         Background="#3A3A3C" Foreground="#0A84FF"
                                         BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="OverlayGpuLoadText" Text="负载 --%"
                                       FontSize="12" Foreground="#6E6E73"/>
                        </StackPanel>
                        <TextBlock x:Name="OverlayGpuTempText" Text="-- °C"
                                   FontSize="42" FontWeight="Light" Foreground="#F2F2F7"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- RAM -->
                <Border Background="#2C2C2E" CornerRadius="14"
                        Margin="0,6,6,0" Padding="22,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RAM"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,0,0,0"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <ProgressBar x:Name="OverlayRamBar"
                                         Height="2" Maximum="100" Value="0"
                                         Background="#3A3A3C" Foreground="#0A84FF"
                                         BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="OverlayRamDetailText" Text="-- / -- GB"
                                       FontSize="12" Foreground="#6E6E73"/>
                        </StackPanel>
                        <TextBlock x:Name="OverlayRamText" Text="-- GB"
                                   FontSize="42" FontWeight="Light" Foreground="#F2F2F7"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Network -->
                <Border Background="#2C2C2E" CornerRadius="14"
                        Margin="6,6,0,0" Padding="22,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="NET"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="↑  上传" FontSize="11"
                                       Foreground="#6E6E73" Margin="0,0,0,2"/>
                            <TextBlock x:Name="OverlayNetUpText" Text="-- MB/s"
                                       FontSize="28" FontWeight="Light"
                                       Foreground="#F2F2F7" Margin="0,0,0,16"/>
                            <TextBlock Text="↓  下载" FontSize="11"
                                       Foreground="#6E6E73" Margin="0,0,0,2"/>
                            <TextBlock x:Name="OverlayNetDownText" Text="-- MB/s"
                                       FontSize="28" FontWeight="Light" Foreground="#F2F2F7"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </UniformGrid>
        </Grid>
</Window>
