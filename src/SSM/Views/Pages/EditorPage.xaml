<UserControl x:Class="SSM.Views.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SSM.Views.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <TextBlock Text="主题预览" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TemplateNameText"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>

        <!-- 实时 Overlay 预览 -->
        <Border Grid.Row="1" Background="{DynamicResource BgDeep}"
                Margin="16" CornerRadius="10">
            <ctrl:OverlayPreviewControl x:Name="Preview"/>
        </Border>
    </Grid>
</UserControl>
