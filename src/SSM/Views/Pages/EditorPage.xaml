<UserControl x:Class="SSM.Views.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <TextBlock Text="自定义主题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="NewThemeButton" Content="＋ 新建主题"
                        Style="{DynamicResource PrimaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="NewThemeButton_Click"/>
            </Grid>
        </Border>

        <!-- 新建主题内联输入框（默认隐藏，覆盖在工具栏上） -->
        <Border x:Name="NewThemePanel" Grid.Row="0"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                CornerRadius="6" Padding="12,6"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,16,0"
                Visibility="Collapsed" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="主题名称：" Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NewThemeNameBox" Width="140" FontSize="12"
                         Background="{DynamicResource BgDeep}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                         Padding="6,4" VerticalAlignment="Center"
                         KeyDown="NewThemeNameBox_KeyDown"/>
                <Button Content="确定" Style="{DynamicResource PrimaryButton}"
                        Margin="8,0,0,0" Padding="10,4"
                        Click="ConfirmNewTheme_Click"/>
                <Button Content="取消" Style="{DynamicResource SecondaryButton}"
                        Margin="4,0,0,0" Padding="10,4"
                        Click="CancelNewTheme_Click"/>
            </StackPanel>
        </Border>

        <!-- 主题卡片区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- 空状态 -->
                <TextBlock x:Name="EmptyHint"
                           Text="暂无自定义主题，点击右上角「＋ 新建主题」开始"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,60,0,0"/>

                <!-- 卡片列表 -->
                <WrapPanel x:Name="ThemeCardPanel" Margin="12,12,12,12"
                           Orientation="Horizontal"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
