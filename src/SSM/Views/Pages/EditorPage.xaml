<UserControl x:Class="SSM.Views.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- MDI: pencil/edit -->
            <Path Width="52" Height="52" HorizontalAlignment="Center" Stretch="Uniform"
                  Fill="{DynamicResource TextSecondary}"
                  Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>

            <TextBlock Text="主题编辑器" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="自定义副屏显示内容、字体、颜色、布局与背景" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="支持拖拽排列组件与实时预览效果" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"/>
            <Border Background="{DynamicResource Accent}" CornerRadius="4"
                    Padding="10,4" Margin="0,22,0,0" HorizontalAlignment="Center">
                <TextBlock Text="即将上线" FontSize="11" Foreground="White" FontWeight="Medium"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
