<UserControl x:Class="SSM.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
        <StackPanel>

            <!-- ══ 外观 ══ -->
            <TextBlock Text="外观" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="主题" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="切换深色或浅色主题" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{DynamicResource ThemeRadioButton}"
                                     Content="深色"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}"
                                     Content="浅色"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                     Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 系统 ══ -->
            <TextBlock Text="系统" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,1"
                    BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="开机自启" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Windows 启动时自动运行 SSM" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorder}" Margin="0,1,0,16"
                    BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="数据刷新频率" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="硬件传感器的采样间隔" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{DynamicResource ComboBoxStyle}"
                              x:Name="RefreshRateCombo"
                              Width="110" VerticalAlignment="Center"
                              SelectionChanged="RefreshRateCombo_SelectionChanged">
                        <ComboBoxItem Tag="500">极快（0.5s）</ComboBoxItem>
                        <ComboBoxItem Tag="1000">标准（1s）</ComboBoxItem>
                        <ComboBoxItem Tag="2000">省电（2s）</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ══ 显示 ══ -->
            <TextBlock Text="显示" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,1"
                    BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="旋转角度" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="旋转内容以匹配副屏的物理朝向" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="Angle"
                                     Content="0°"   IsChecked="{Binding IsAngle0,   Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="Angle"
                                     Content="90°"  IsChecked="{Binding IsAngle90,  Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="Angle"
                                     Content="180°" IsChecked="{Binding IsAngle180, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="Angle"
                                     Content="270°" IsChecked="{Binding IsAngle270, Mode=TwoWay}"
                                     Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorder}" Margin="0,1,0,16"
                    BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="适配方式" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="主题画面在屏幕上的缩放规则" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="FitMode"
                                     Content="默认" IsChecked="{Binding IsFitFit, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="FitMode"
                                     Content="居中"       IsChecked="{Binding IsFitCenter, Mode=TwoWay}"/>
                        <RadioButton Style="{DynamicResource ThemeRadioButton}" GroupName="FitMode"
                                     Content="拉伸"       IsChecked="{Binding IsFitStretch, Mode=TwoWay}"
                                     Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 快捷键 ══ -->
            <TextBlock Text="快捷键" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="停止投放" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="点击右侧框后按新组合键即可修改" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="HotkeyBorder"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6"
                            Background="{DynamicResource BgDeep}">
                        <TextBox x:Name="HotkeyBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10,5" MinWidth="150" TextAlignment="Center"
                                 CaretBrush="Transparent"
                                 FocusVisualStyle="{x:Null}"
                                 Cursor="Hand"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"/>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
