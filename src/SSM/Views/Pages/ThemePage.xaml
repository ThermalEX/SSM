<UserControl x:Class="SSM.Views.Pages.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <TextBlock Text="主题库" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="ImportBtn" Content="导入 .spzip"
                        Style="{DynamicResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Import_Click"/>
            </Grid>
        </Border>

        <!-- 主题卡片滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="CardPanel" Margin="12" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</UserControl>
