<Window x:Class="SSM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SSM" Height="580" Width="860"
        MinHeight="480" MinWidth="720"
        WindowStyle="None"
        Background="{DynamicResource BgDeep}"
        ResizeMode="CanResize">

    <!-- WindowChrome 消除顶部白边，同时提供拖拽和 resize 支持 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgDeep}" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- ── 标题栏 ── -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource TitleBarBg}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题居左，从列 0 开始 -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="SSM" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="  Secondary Screen Monitor" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 窗口控件 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{DynamicResource WindowControlButton}"
                                Foreground="{DynamicResource TextSecondary}"
                                Click="MinimizeButton_Click">
                            <TextBlock Text="—" FontSize="11"/>
                        </Button>
                        <Button Style="{DynamicResource CloseWindowButton}"
                                Foreground="{DynamicResource TextSecondary}"
                                Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 侧边栏 ── -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                    Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">

                    <Grid x:Name="NavDashboard">
                        <Border x:Name="NavDashboardIndicator" Width="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" CornerRadius="0,2,2,0" Visibility="Visible"/>
                        <Button Style="{DynamicResource NavButton}" Tag="dashboard"
                                Click="NavButton_Click" Width="72">
                            <StackPanel>
                                <!-- MDI: desktop-windows -->
                                <Path x:Name="NavDashboardIcon" Width="22" Height="22" HorizontalAlignment="Center" Stretch="Uniform"
                                      Fill="{DynamicResource Accent}"
                                      Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z"/>
                                <TextBlock x:Name="NavDashboardLabel" Text="监控" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid x:Name="NavTheme" Margin="0,10,0,0">
                        <Border x:Name="NavThemeIndicator" Width="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                        <Button Style="{DynamicResource NavButton}" Tag="theme"
                                Click="NavButton_Click" Width="72">
                            <StackPanel>
                                <!-- MDI: palette -->
                                <Path x:Name="NavThemeIcon" Width="22" Height="22" HorizontalAlignment="Center" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"
                                      Data="M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.12 13.36,18.78 13.13,18.53C12.9,18.28 12.75,17.94 12.75,17.5A1.5,1.5 0 0,1 14.25,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3Z"/>
                                <TextBlock x:Name="NavThemeLabel" Text="主题" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid x:Name="NavEditor" Margin="0,10,0,0">
                        <Border x:Name="NavEditorIndicator" Width="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                        <Button Style="{DynamicResource NavButton}" Tag="editor"
                                Click="NavButton_Click" Width="72">
                            <StackPanel>
                                <!-- MDI: pencil -->
                                <Path x:Name="NavEditorIcon" Width="22" Height="22" HorizontalAlignment="Center" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"
                                      Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                                <TextBlock x:Name="NavEditorLabel" Text="编辑" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid x:Name="NavSettings" Margin="0,10,0,0">
                        <Border x:Name="NavSettingsIndicator" Width="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" CornerRadius="0,2,2,0" Visibility="Collapsed"/>
                        <Button Style="{DynamicResource NavButton}" Tag="settings"
                                Click="NavButton_Click" Width="72">
                            <StackPanel>
                                <!-- MDI: cog/settings -->
                                <Path x:Name="NavSettingsIcon" Width="22" Height="22" HorizontalAlignment="Center" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"
                                      Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                                <TextBlock x:Name="NavSettingsLabel" Text="设置" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── 主内容区 ── -->
            <Grid Grid.Row="1" Grid.Column="1">

                <!-- 仪表盘（默认显示） -->
                <ScrollViewer x:Name="DashboardView"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,14,16,0">
                    <StackPanel>
                        <!-- 标题行 + 编辑按钮 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="实时监控" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="EditLayoutButton" Grid.Column="1"
                                    Style="{DynamicResource WindowControlButton}"
                                    Click="EditLayout_Click"
                                    Height="22" Padding="8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EditLayoutText" Text="编辑" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </Grid>

                        <!-- 动态卡片区 -->
                        <UniformGrid x:Name="DashboardGrid" Columns="4"/>

                        <!-- 已隐藏卡片芯片区（仅编辑模式可见） -->
                        <WrapPanel x:Name="HiddenWidgetsPanel" Visibility="Collapsed"
                                   Margin="0,8,0,0" Orientation="Horizontal"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 主题页 -->
                <ContentControl x:Name="ThemeView" Visibility="Collapsed"/>
                <!-- 编辑页 -->
                <ContentControl x:Name="EditorView" Visibility="Collapsed"/>
                <!-- 设置页 -->
                <ContentControl x:Name="SettingsView" Visibility="Collapsed"/>

            </Grid>

            <!-- ── 底部状态栏 ── -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="{DynamicResource TitleBarBg}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="投放到："
                               Foreground="{DynamicResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="ScreenSelector"
                              Style="{DynamicResource ComboBoxStyle}"
                              Width="200" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="RefreshScreensButton"
                            Style="{DynamicResource WindowControlButton}"
                            Click="RefreshScreens_Click"
                            ToolTip="刷新显示器列表"
                            VerticalAlignment="Center" Margin="4,0,0,0" Width="28" Height="28">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondary}"
                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </Button>
                    <!-- 投放状态指示点 -->
                    <Ellipse x:Name="TitleDot" Grid.Column="3" Width="7" Height="7"
                             Fill="{DynamicResource TextSecondary}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Grid.Column="4" x:Name="ToggleOverlayButton"
                            Style="{DynamicResource PrimaryButton}"
                            Click="ToggleOverlay_Click"
                            ToolTip="投放中可用 Ctrl+Shift+S 或 Esc 快速停止"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- MDI: play -->
                            <Path x:Name="OverlayBtnIcon" Width="13" Height="13" Stretch="Uniform"
                                  Fill="White" VerticalAlignment="Center"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                            <TextBlock x:Name="OverlayBtnText" Text="开始投放"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
