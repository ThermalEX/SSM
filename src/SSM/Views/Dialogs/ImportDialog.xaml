<Window x:Class="SSM.Views.Dialogs.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入主题" Width="440" Height="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
            CornerRadius="12"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35"
                              Color="Black" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="16,0">
                <TextBlock Text="导入主题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="24" Padding="0"
                        Style="{DynamicResource SecondaryButton}"
                        Click="Close_Click"/>
            </Grid>
            <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1" IsHitTestVisible="False"/>

            <!-- 拖放区 -->
            <Border Grid.Row="1" Margin="20,16,20,8" CornerRadius="8"
                    x:Name="DropZone" Cursor="Hand"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    MouseLeftButtonUp="DropZone_Click">
                <Border.Background>
                    <SolidColorBrush Color="Transparent"/>
                </Border.Background>
                <Border.BorderThickness>
                    <Thickness>0</Thickness>
                </Border.BorderThickness>
                <!-- 虚线边框用 Rectangle 模拟 -->
                <Grid>
                    <Rectangle RadiusX="8" RadiusY="8"
                               StrokeThickness="1.5" Stretch="Fill"
                               StrokeDashArray="6,4" Fill="Transparent"
                               Stroke="{DynamicResource Accent}"
                               IsHitTestVisible="False"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="拖入主题文件" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text=".spzip / .sensorpanel / .sp2" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,2,0,2"/>
                        <TextBlock Text="或点击此处选择文件" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 错误提示 + 取消按钮 -->
            <Grid Grid.Row="2" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11" Foreground="#E57373"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <Button Grid.Column="1" Content="取消"
                        VerticalAlignment="Center"
                        Style="{DynamicResource SecondaryButton}"
                        Padding="16,6" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
